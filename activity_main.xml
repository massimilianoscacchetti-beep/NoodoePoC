<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- STATUS BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: "
            android:textStyle="bold"
            android:textSize="16sp" />
        
        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Idle"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray" />

    <!-- SECTION 1: SCAN -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. SCAN & DISCOVERY"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        
        <Button
            android:id="@+id/scanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Scan"
            android:layout_marginEnd="4dp" />
        
        <Button
            android:id="@+id/stopScanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop Scan"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- DEVICE LIST -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Found Devices (tap to connect):"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:textStyle="italic" />

    <ListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@android:color/darker_gray"
        android:alpha="0.1"
        android:layout_marginTop="4dp" />

    <!-- SECTION 2: CONNECTION & DEBUG -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2. DEBUG & CONTROL"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        
        <Button
            android:id="@+id/readChallengeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Read Auth"
            android:textSize="11sp"
            android:layout_marginEnd="2dp" />
    </LinearLayout>

    <!-- SECTION 3: COMMAND TESTING -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3. SEND TEST COMMANDS"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/commandInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="Inserisci payload test (es: 'test123')"
        android:inputType="text"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@android:drawable/editbox_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        
        <Button
            android:id="@+id/sendCommandButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send Command"
            android:textSize="11sp"
            android:layout_marginEnd="2dp" />
        
        <Button
            android:id="@+id/assetCommitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Asset Commit"
            android:textSize="11sp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- SECTION 4: OUTPUT LOG -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4. LOG OUTPUT"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@android:color/darker_gray"
        android:alpha="0.05">
        
        <TextView
            android:id="@+id/logOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Log output will appear here]"
            android:textSize="11sp"
            android:textFamily="monospace"
            android:padding="8dp" />
    </ScrollView>

</LinearLayout>
